# NKT Mobile — Local Production-Like (Expo)
# Copy to .env.local for real API testing against local stack.
# Use LAN IP when testing on physical device (not localhost).

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_USE_MOCK_REALTIME=false

# Emulator/simulator:
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_REALTIME_URL=http://localhost:3001

# Physical device (replace with your machine LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# EXPO_PUBLIC_REALTIME_URL=http://192.168.1.100:3001
