# NKT VPS Deployment — Environment Variable Reference
# Copy .env.production.example to .env.production and fill all values.

# Domains
API_HOST=
REALTIME_HOST=
ADMIN_HOST=
VITE_API_URL=

# Database (isolated)
POSTGRES_USER=nkt
POSTGRES_PASSWORD=
POSTGRES_DB=nkt

# Redis (isolated, internal only)
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Ports (nginx only exposed publicly)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Admin seed (first deploy)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# See .env.production.example for full list
