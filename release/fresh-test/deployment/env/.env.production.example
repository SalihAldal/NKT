# NKT Production Environment — copy to .env.production and fill ALL values
# NEVER commit .env.production to git or include in deployment ZIP

# ── Image versioning ──────────────────────────────────────────────────────────
IMAGE_TAG=1.0.0
GIT_SHA=

# ── Domains (configure DNS A/CNAME records to your VPS) ───────────────────────
# Replace YOUR_DOMAIN with your actual domain before deploy
API_HOST=api.YOUR_DOMAIN
REALTIME_HOST=realtime.YOUR_DOMAIN
ADMIN_HOST=admin.YOUR_DOMAIN
VITE_API_URL=https://api.YOUR_DOMAIN/api/v1

# ── Smoke test public URLs ────────────────────────────────────────────────────
SMOKE_API_URL=https://api.YOUR_DOMAIN
SMOKE_REALTIME_URL=https://realtime.YOUR_DOMAIN
SMOKE_ADMIN_URL=https://admin.YOUR_DOMAIN

# ── SSL (set true after Let's Encrypt certificates installed) ─────────────────
ENABLE_SSL=false

# ── Nginx public ports (change if 80/443 already used by another project) ─────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── PostgreSQL (isolated NKT database — do not share with other projects) ─────
POSTGRES_USER=nkt
POSTGRES_PASSWORD=
POSTGRES_DB=nkt
DB_POOL_SIZE=8
POSTGRES_CPU_LIMIT=0.75
POSTGRES_MEM_LIMIT=768M

# ── Redis (isolated NKT instance — internal network only) ─────────────────────
REDIS_PASSWORD=
REDIS_MAXMEMORY=192mb
REDIS_CPU_LIMIT=0.25
REDIS_MEM_LIMIT=256M

# ── JWT (min 32 chars each — generate with: openssl rand -base64 48) ────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── CORS (comma-separated) ────────────────────────────────────────────────────
CORS_ORIGINS=https://admin.YOUR_DOMAIN

# ── Resource limits (lightweight VPS defaults) ────────────────────────────────
API_CPU_LIMIT=0.75
API_MEM_LIMIT=512M
REALTIME_CPU_LIMIT=0.5
REALTIME_MEM_LIMIT=384M
WORKER_CPU_LIMIT=0.5
WORKER_MEM_LIMIT=512M
ADMIN_CPU_LIMIT=0.25
ADMIN_MEM_LIMIT=192M
NGINX_CPU_LIMIT=0.25
NGINX_MEM_LIMIT=192M

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local

# ── Admin seed (required for first deploy only) ───────────────────────────────
ADMIN_SEED_EMAIL=admin@YOUR_DOMAIN
ADMIN_SEED_PASSWORD=

# ── Content import (set true only during first content import, then false) ────
ALLOW_CONTENT_IMPORT=false

# ── Push / IAP (optional) ─────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
APPLE_SHARED_SECRET=
APPLE_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── AI limits ─────────────────────────────────────────────────────────────────
AI_MAX_BATCH_SIZE=25
AI_RATE_LIMIT_PER_HOUR=3

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=3
BACKUP_DIR=./deployment/backups
BACKUP_EXTERNAL_PATH=

# ── Production guards ─────────────────────────────────────────────────────────
USE_MOCK_PAYMENT=false
NODE_ENV=production
