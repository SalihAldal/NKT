{
  "name": "nkt-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:worker": "SERVICE_ROLE=worker node dist/index.js",
    "start:realtime": "SERVICE_ROLE=realtime node dist/index.js",
    "start:api": "SERVICE_ROLE=api node dist/index.js",
    "build": "tsc -p tsconfig.build.json && prisma generate",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:validate": "tsx scripts/validate-migrations.ts",
    "db:integrity": "tsx scripts/db-integrity-test.ts",
    "db:import-content": "tsx prisma/import-content.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/db-reset-dev-only.ts",
    "db:studio": "prisma studio",
    "worker": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.53.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
