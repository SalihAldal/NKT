# EAS Production Environment Variables
# Set these in EAS Secrets (eas secret:create) or replace example.com with your domain before build.
#
# EXPO_PUBLIC_API_URL=https://api.YOURDOMAIN.com
# EXPO_PUBLIC_REALTIME_URL=https://realtime.YOURDOMAIN.com
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_USE_MOCK_API=false
# EXPO_PUBLIC_USE_MOCK_REALTIME=false
