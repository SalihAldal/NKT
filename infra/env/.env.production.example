#!/usr/bin/env bash
# NKT Production Environment — copy to .env.production and fill values
# NEVER commit real secrets to git

# ── Image versioning ──────────────────────────────────────────────────────────
IMAGE_TAG=1.2.0
GIT_SHA=

# ── Domains (configure your DNS A/CNAME records) ─────────────────────────────
API_HOST=api.example.com
REALTIME_HOST=realtime.example.com
ADMIN_HOST=admin.example.com
# Admin HTTP client base — MUST include /api/v1 prefix
VITE_API_URL=https://api.example.com/api/v1

# ── Smoke test public URLs (HTTPS after certbot) ──────────────────────────────
SMOKE_API_URL=https://api.example.com
SMOKE_REALTIME_URL=https://realtime.example.com
SMOKE_ADMIN_URL=https://admin.example.com

# ── SSL (set true after certbot certificates installed) ───────────────────────
ENABLE_SSL=false

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=nkt
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nkt
DB_POOL_SIZE=10
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEM_LIMIT=1G

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAXMEMORY=256mb
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=512M

# ── JWT (min 32 chars each) ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS

# ── CORS (comma-separated) ────────────────────────────────────────────────────
CORS_ORIGINS=https://admin.example.com

# ── Resource limits ───────────────────────────────────────────────────────────
API_CPU_LIMIT=1.0
API_MEM_LIMIT=768M
REALTIME_CPU_LIMIT=1.0
REALTIME_MEM_LIMIT=512M
WORKER_CPU_LIMIT=1.0
WORKER_MEM_LIMIT=768M
ADMIN_CPU_LIMIT=0.5
ADMIN_MEM_LIMIT=256M
NGINX_CPU_LIMIT=0.5
NGINX_MEM_LIMIT=256M

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local

# ── Push / IAP (optional) ─────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
APPLE_SHARED_SECRET=
APPLE_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── AI limits ─────────────────────────────────────────────────────────────────
AI_MAX_BATCH_SIZE=50
AI_RATE_LIMIT_PER_HOUR=5

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=3
# Mount external backup destination on VPS (e.g. /mnt/backups)
BACKUP_EXTERNAL_PATH=

# ── Production guards ─────────────────────────────────────────────────────────
USE_MOCK_PAYMENT=false
NODE_ENV=production
