# NKT Staging Environment — copy to .env.staging

IMAGE_TAG=staging
GIT_SHA=

API_HOST=staging-api.example.com
REALTIME_HOST=staging-realtime.example.com
ADMIN_HOST=staging-admin.example.com
VITE_API_URL=https://staging-api.example.com

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

POSTGRES_USER=nkt
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD
POSTGRES_DB=nkt_staging
DB_POOL_SIZE=5

REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS
REDIS_MAXMEMORY=128mb

JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS_SECRET_MIN_32
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH_SECRET_MIN_32

CORS_ORIGINS=https://staging-admin.example.com,http://localhost:5173

STORAGE_PROVIDER=local
EXPO_ACCESS_TOKEN=
APPLE_SHARED_SECRET=
APPLE_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=

BACKUP_RETENTION_DAYS=3
BACKUP_RETENTION_WEEKS=2
BACKUP_RETENTION_MONTHS=1
