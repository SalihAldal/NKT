# HTTPS Admin SPA — substitute ${ADMIN_HOST}

upstream nkt_admin_ssl {
    server nkt-admin:8080;
    keepalive 8;
}

server {
    listen 80;
    server_name ${ADMIN_HOST};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${ADMIN_HOST};

    ssl_certificate /etc/nginx/ssl/live/${ADMIN_HOST}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/${ADMIN_HOST}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /health {
        proxy_pass http://nkt_admin_ssl;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        proxy_pass http://nkt_admin_ssl;
        include /etc/nginx/proxy_params.conf;
    }
}
