# NKT Server Environment
NODE_ENV=development
SERVICE_ROLE=all
PORT=3000
REALTIME_PORT=3001
WORKER_HEALTH_PORT=3002
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://nkt:nkt_dev_password@localhost:5432/nkt?schema=public
DB_POOL_SIZE=10
# Production: use prisma migrate deploy (never db push / migrate reset)
# Seed: npm run db:seed (requires ALLOW_PRODUCTION_SEED=true in production)
# Content: npm run db:import-content (requires ALLOW_CONTENT_IMPORT=true in production)

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,exp://localhost:8081

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Storage (optional)
STORAGE_PROVIDER=local
STORAGE_BUCKET=

# Push (optional)
EXPO_ACCESS_TOKEN=

# IAP (optional)
APPLE_SHARED_SECRET=
APPLE_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Admin seed (required for db:seed — min 8 chars, set in your local .env)
ADMIN_SEED_EMAIL=admin@localhost
ADMIN_SEED_PASSWORD=

# Versioning
IMAGE_TAG=local
GIT_SHA=dev
