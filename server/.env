# NKT Local Production-Like Environment (server)
# Copy to server/.env and adjust. Never commit real secrets.

NODE_ENV=development
SERVICE_ROLE=all
PORT=3000
REALTIME_PORT=3001
WORKER_HEALTH_PORT=3002
HOST=0.0.0.0

DATABASE_URL=postgresql://nkt:nkt_dev_password@localhost:5434/nkt?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=local-dev-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=local-dev-refresh-secret-min-32-chars!

CORS_ORIGINS=http://localhost:5173,http://localhost:8081,exp://localhost:8081,http://127.0.0.1:5173

USE_MOCK_PAYMENT=false
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# Required for db:seed (min 8 chars)
ADMIN_SEED_EMAIL=admin@localhost
ADMIN_SEED_PASSWORD=

# Content import (dev)
ALLOW_CONTENT_IMPORT=true

ADMIN_SEED_PASSWORD=LocalDevAdmin1!
