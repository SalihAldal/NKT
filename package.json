{
  "name": "nkt",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:generate": "tsx scripts/generate-content-dataset.ts",
    "admin:dev": "npm run dev --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "server:dev": "npm run dev --prefix server",
    "server:build": "npm run build --prefix server",
    "server:test": "npm run test --prefix server",
    "server:db:up": "docker compose -f server/docker-compose.yml up -d",
    "server:db:migrate": "npm run db:migrate:deploy --prefix server",
    "server:db:validate": "npm run db:validate --prefix server",
    "server:db:integrity": "npm run db:integrity --prefix server",
    "server:db:seed": "npm run db:seed --prefix server",
    "audit:artifacts": "tsx scripts/audit-artifacts.ts",
    "audit:content": "tsx scripts/audit-content-release.ts",
    "package:vps": "node scripts/build-vps-package.mjs",
    "test:vps-live": "node scripts/phase26-vps-live-e2e.mjs",
    "test:content-difficulty": "npx tsx scripts/audit-content-difficulty.ts",
    "audit:licenses": "tsx scripts/audit-licenses.ts",
    "audit:final": "tsx scripts/final-release-audit.ts",
    "audit:content-sample": "tsx scripts/content-quality-sample.ts",
    "infra:validate": "bash infra/scripts/validate-compose.sh",
    "infra:check-config": "bash infra/scripts/check-production-config.sh",
    "infra:deploy": "bash infra/scripts/deploy.sh",
    "infra:backup": "bash infra/scripts/backup-db.sh",
    "infra:smoke": "bash infra/scripts/smoke-test.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@tanstack/react-query": "^5.85.5",
    "expo": "~57.0.18",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
