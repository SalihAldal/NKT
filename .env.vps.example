# NKT Mobile — Live VPS device test (HTTP + IP, no SSL)
# Copy to .env.local before: npx expo start

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_USE_MOCK_REALTIME=false

# VPS public IP (nginx routes /api/ and /socket.io/)
EXPO_PUBLIC_API_URL=http://76.13.138.159
EXPO_PUBLIC_REALTIME_URL=http://76.13.138.159

# Android: allow HTTP to VPS IP (no SSL in this phase)
EXPO_PUBLIC_ALLOW_CLEARTEXT=true
