EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_REALTIME_URL=http://localhost:3000
EXPO_PUBLIC_USE_MOCK_API=true
EXPO_PUBLIC_USE_MOCK_REALTIME=true
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEEP_LINK_HOST=taniyormusun.app
EXPO_PUBLIC_MIN_SUPPORTED_VERSION=1.0.0
EXPO_PUBLIC_APP_VERSION=1.2.0
EXPO_PUBLIC_IOS_BUILD_NUMBER=1
EXPO_PUBLIC_ANDROID_VERSION_CODE=12

# Legal / store URLs (configure before submission — no fake URLs)
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_USES_TRACKING=false

# IAP product IDs (configure in App Store Connect / Play Console)
EXPO_PUBLIC_IOS_PREMIUM_WEEKLY=
EXPO_PUBLIC_IOS_PREMIUM_MONTHLY=
EXPO_PUBLIC_ANDROID_PREMIUM_WEEKLY=
EXPO_PUBLIC_ANDROID_PREMIUM_MONTHLY=

# Ads (test units used in development/staging)
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_REWARDED_ADS_ENABLED=true
EXPO_PUBLIC_IOS_AD_BANNER=
EXPO_PUBLIC_IOS_AD_INTERSTITIAL=
EXPO_PUBLIC_IOS_AD_REWARDED=
EXPO_PUBLIC_ANDROID_AD_BANNER=
EXPO_PUBLIC_ANDROID_AD_INTERSTITIAL=
EXPO_PUBLIC_ANDROID_AD_REWARDED=

# Monetization
EXPO_PUBLIC_GRACE_PERIOD_DAYS=3
EXPO_PUBLIC_STALE_ENTITLEMENT_HOURS=24
EXPO_PUBLIC_ERROR_MONITORING=true
